# ===== 第二大脑 | 环境变量模板 =====
# 复制本文件为 .env 并按需修改

# DashScope（LLM / Embedding）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 数据目录（相对项目根目录）
DATA_DIR=data
RAW_DIR=data/raw          # 原始文件区
KB_DIR=data/kb            # 知识库笔记
INPUT_DIR=data/input      # AI 生成 md 默认输出目录

# MySQL（RAG 库，启动自动建库建表）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=RAG

# Neo4j（阶段三接入，预留）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain2026